# HTTP server
PORT=3000
API_BASE_URL=http://localhost:3000
WALLET_ADDRESS=

# testnet (local demo) or mainnet (Challenge deployment)
ALGORAND_NETWORK=testnet

# Public address that receives USDC. The server never needs its private key.
PAY_TO_ADDRESS=
FACILITATOR_URL=https://facilitator.goplausible.xyz
PRICE_USDC=$0.001

# Public account-data source. Defaults to AlgoNode when omitted.
# INDEXER_URL=https://testnet-idx.algonode.cloud

# Optional: disposable TestNet wallet for CLI buyer scripts only. The website always
# connects to the visitor's Pera Wallet and never receives a mnemonic.
CLIENT_MNEMONIC=

# Enable only for a public MainNet Global x402 Challenge deployment.
CHALLENGE_MODE=false

# direct uses a known URL; bazaar performs real facilitator catalog discovery.
AGENT_DISCOVERY=direct

# Free quota/API-key layer for matching published ClaimReview fact checks.
# Create a restricted server key in Google Cloud; never expose it to the browser.
GOOGLE_FACTCHECK_API_KEY=

# Optional evidence-bounded fallback reasoning. A free Groq developer key works;
# it is used only after public evidence is retrieved and never leaves the server.
GROQ_API_KEY=

# Optional Groq model override (default: openai/gpt-oss-20b).
# GROQ_MODEL=openai/gpt-oss-20b
